# The panel API (spec section 6.2) on FrankenPHP. Build from the repository root:
#   podman build -f images/panel-api/Containerfile -t panel-api .
# SPDX-License-Identifier: AGPL-3.0-only
FROM docker.io/library/composer:2 AS vendor
WORKDIR /app
COPY api/composer.json api/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY api/ ./
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

FROM docker.io/dunglas/frankenphp:1-php8.4-trixie
# CVE scan, finding 3: take the Debian security fixes that are newer than the base image.
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/* \
 && install-php-extensions pdo_sqlite pdo_pgsql intl opcache pcntl \
 && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
# Audit batch 2, finding 1: the base image gives frankenphp the file capability
# cap_net_bind_service. The units drop all capabilities, and Linux does not run a file with a
# capability that the process cannot get. The server listens on 8080, so it does not need it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libcap2-bin \
 && setcap -r /usr/local/bin/frankenphp \
 && test -z "$(getcap /usr/local/bin/frankenphp)" \
 && apt-get purge -y libcap2-bin \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=vendor /app /app
COPY openapi/openapi.yaml /app/public/openapi.yaml
COPY images/panel-api/start.sh /usr/local/bin/panel-start
# The API runs as root in a rootless container, with no capabilities. With no DAC_OVERRIDE,
# root can write only to files that root owns, so storage and bootstrap/cache stay root's.
RUN rm -rf tests .env

ENV APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr \
    SERVER_NAME=:8080 XDG_CONFIG_HOME=/tmp/config XDG_DATA_HOME=/tmp/data
EXPOSE 8080
CMD ["/usr/local/bin/panel-start"]
LABEL org.opencontainers.image.source="https://github.com/itbm/cloudfactory" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.description="Cloudfactory panel API"
