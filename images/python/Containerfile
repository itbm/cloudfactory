# Python runtime image. Build one image for each Python version:
#   podman build --build-arg PYTHON_VERSION=3.14 -t python3.14 images/python
#
# The container runs the start command of the website, for example
# "gunicorn --bind 0.0.0.0:$PORT app:app", in the application directory (CF_APP_DIR, the
# document root of the website). The application listens on the port in the variable PORT
# (8080). The agent runs the install command, for example
# "python -m venv .venv && .venv/bin/pip install -r requirements.txt", in a build container of
# this image. The start script uses the virtual environment ".venv" of the application
# directory when it is there.
# SPDX-License-Identifier: AGPL-3.0-only
ARG PYTHON_VERSION=3.14
FROM docker.io/library/python:${PYTHON_VERSION}-slim-trixie

ARG DEBIAN_FRONTEND=noninteractive
# Deploys from Git: the agent gets the code and runs the build commands in a container of this
# image, so the image has Git and an SSH client. A package with no wheel for this Python
# version builds its C code, which needs a C compiler.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates gcc libc6-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*
# CVE scan, finding 3: take the Debian security fixes that are newer than the base image. The
# release workflow gives CF_REFRESH a new value for each build, so this step never comes from
# the build cache.
ARG CF_REFRESH
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 cf-app /usr/local/bin/cf-app
COPY welcome.py /usr/local/share/cloudfactory/welcome.py

# The container root file system is read-only. pip keeps its cache in /tmp.
ENV HOME=/tmp \
    PIP_CACHE_DIR=/tmp/.pip \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080 \
    HOST=0.0.0.0 \
    CF_APP_DIR=/app

WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/cf-app"]
CMD ["sh", "-c", "python app.py"]
LABEL org.opencontainers.image.source="https://github.com/itbm/cloudfactory" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.description="Cloudfactory Python runtime"
