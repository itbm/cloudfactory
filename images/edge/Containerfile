# The edge proxy (spec section 6.2). The agent sets its routes through the admin API.
# SPDX-License-Identifier: AGPL-3.0-only
# CVE scan, finding 1: the Caddy binary in the caddy:2.11-alpine image is built with a Go
# release and a golang.org/x/net version that have HTTP/1 and HTTP/2 denial-of-service bugs.
# Build the same Caddy release with a patched Go and x/net, and use it in place of that binary.
# Change the versions here and in the other Caddy image (edge, panel-web) together.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4-alpine AS caddy
ARG TARGETOS TARGETARCH
ARG CADDY_VERSION=v2.11.7
ARG X_NET_VERSION=v0.61.0
WORKDIR /src
RUN printf '%s\n' 'package main' \
      'import (' \
      '	caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
      '	_ "github.com/caddyserver/caddy/v2/modules/standard"' \
      ')' \
      'func main() { caddycmd.Main() }' > main.go \
 && go mod init cloudfactory/caddy \
 && go get "github.com/caddyserver/caddy/v2@${CADDY_VERSION}" "golang.org/x/net@${X_NET_VERSION}" \
 && go mod tidy \
 && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-amd64}" go build -trimpath -ldflags "-s -w" -o /usr/bin/caddy . \
 && go version -m /usr/bin/caddy | grep -E "^/usr/bin/caddy|caddy/v2|x/net"

FROM docker.io/library/caddy:2.11-alpine
# Take the security fixes of Alpine that are newer than the base image. The release workflow
# gives CF_REFRESH a new value for each build, so this step never comes from the build cache.
ARG CF_REFRESH
RUN apk upgrade --no-cache
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy

COPY base.json /etc/caddy/base.json
# Caddy keeps the configuration from the agent in /data, and loads it again at start.
ENV XDG_CONFIG_HOME=/data/config XDG_DATA_HOME=/data
# The admin API is a Unix socket in /run/caddy-admin, not a port.
EXPOSE 8080 8443 8443/udp
CMD ["caddy", "run", "--config", "/etc/caddy/base.json", "--resume"]
LABEL org.opencontainers.image.source="https://github.com/itbm/cloudfactory" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.description="Cloudfactory edge proxy"
