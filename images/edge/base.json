{
  "admin": { "listen": "unix//run/caddy-admin/admin.sock" },
  "logging": {
    "logs": {
      "access": {
        "writer": { "output": "net", "address": "tcp/169.254.77.1:19514", "dial_timeout": "2s", "soft_start": true },
        "encoder": { "format": "json", "time_format": "rfc3339_nano", "duration_format": "seconds" },
        "include": ["http.log.access"]
      },
      "firewall": {
        "writer": { "output": "file", "filename": "/data/logs/firewall.log", "roll_size_mb": 20, "roll_keep": 1 },
        "encoder": { "format": "json" },
        "include": ["http.handlers.waf"]
      },
      "default": { "exclude": ["http.log.access", "http.handlers.waf"] }
    }
  },
  "apps": {
    "http": {
      "http_port": 8080,
      "https_port": 8443,
      "servers": {
        "edge": {
          "listen": [":8443"],
          "routes": [],
          "logs": { "default_logger_name": "access" },
          "automatic_https": { "ignore_loaded_certificates": true }
        }
      }
    }
  }
}
