# The MariaDB service image. Each MariaDB database server of a customer has its own container. The release pipeline signs it like all other images (FR-1101).
# SPDX-License-Identifier: AGPL-3.0-only
# 12.3 is a long-term support release of MariaDB. Use only a long-term support release here.
FROM docker.io/library/mariadb:12.3
# CVE scan, finding 3: take the security fixes that are newer than the base image. The release
# workflow gives CF_REFRESH a new value for each build, so this step never comes from the build
# cache.
ARG DEBIAN_FRONTEND=noninteractive
ARG CF_REFRESH
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
# The agent starts each database server as the user 999 and the group 999, which is the user
# mysql of the base image. The Unix user of the database server on the host owns the data
# files, and has this ID in the container. A base image with a different ID stops the build.
RUN test "$(id -u mysql):$(id -g mysql)" = 999:999
LABEL org.opencontainers.image.source="https://github.com/itbm/cloudfactory" \
      org.opencontainers.image.description="Cloudfactory MariaDB service"
