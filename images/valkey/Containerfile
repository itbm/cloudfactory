# The Valkey service image. Each customer has its own container. The release pipeline signs the image like all other images (FR-1101).
# SPDX-License-Identifier: AGPL-3.0-only
# The agent needs release 9.1.2 or later: from release 9.1, a user can have access to one
# database number only, and release 9.1.2 closes the last way out of that database.
FROM docker.io/valkey/valkey:9.1
# CVE scan, finding 3: take the security fixes that are newer than the base image. The release
# workflow gives CF_REFRESH a new value for each build, so this step never comes from the build
# cache.
ARG DEBIAN_FRONTEND=noninteractive
ARG CF_REFRESH
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.source="https://github.com/itbm/cloudfactory" \
      org.opencontainers.image.description="Cloudfactory Valkey service"
