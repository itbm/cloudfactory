{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		# The pages of plugins open in a frame with the origin of the plugin (docs/plugins.md).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src https:; frame-ancestors 'none'"
		# R-17: the edge proxy serves the panel only over HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# The web panel is a single-page application.
	try_files {path} /index.html
	file_server
}
